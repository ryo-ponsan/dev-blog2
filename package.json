{
  "name": "starter-blog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "node scripts/generate-content.mjs && next build --webpack && node -r esbuild-register ./scripts/postbuild.mjs",
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "node scripts/generate-content.mjs && tsc --noEmit",
    "serve": "next start",
    "analyze": "node scripts/generate-content.mjs && cross-env ANALYZE=true next build --webpack",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test scripts/*.test.mjs",
    "verify": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@next/bundle-analyzer": "16.4.5",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "autoprefixer": "^10.4.13",
    "esbuild": "0.28.2",
    "github-slugger": "^2.0.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "postcss": "8.5.32",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-type-animation": "^3.2.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "2.3.2",
    "rehype-katex": "7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "3.4.19",
    "sharp": "0.35.5",
    "@giscus/react": "3.1.0",
    "gray-matter": "4.0.3",
    "mdx-bundler": "10.1.1",
    "remark": "15.0.1",
    "unist-util-visit": "5.2.0",
    "mdast-util-to-string": "4.0.0",
    "probe-image-size": "7.5.0",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/react": "18.3.31",
    "cross-env": "^10.1.0",
    "dedent": "^0.7.0",
    "esbuild-register": "^3.6.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "file-loader": "^6.0.0",
    "husky": "^8.0.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3",
    "@types/react-dom": "18.3.7",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "overrides": {
    "js-yaml@^4.0.0": "4.3.2",
    "js-yaml@^3.0.0": "3.15.2",
    "postcss-selector-parser@^6": "6.1.5",
    "remark-mdx-frontmatter": {
      "toml": "5.0.1"
    },
    "uuid@^9": "11.1.1",
    "katex": "0.19.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
